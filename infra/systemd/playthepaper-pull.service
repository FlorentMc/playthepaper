# Play the Paper: refresh both static checkouts from GitHub. Fired by playthepaper-pull.timer.
#
#   /var/www/playthepaper/src  <- branch `live`  (main after `validate-content` passed; content/ is served from here)
#   /var/www/playthepaper/app  <- branch `build` (Flutter web build, force-pushed by `build-web`)
#
# Nothing is built on this box: fetch, hard-reset, done. Files are served
# directly from the checkouts. A step that fails stops the unit (the timer
# retries in 5 minutes); the order is content first, app second.
#
# Edition boundary: edition dates roll at 04:00 UTC. The nightly news upgrade
# for edition date D is pushed to `main` around 02:30-03:30 UTC on D, promoted
# to `live` by CI, and picked up here within 5 minutes; it must be on disk
# before 04:00 UTC. Do not change the 5-minute cadence without re-checking the
# 03:10 / 03:45 UTC watch times in .github/workflows/edition-watch.yml.
#
# Install: install -m 644 playthepaper-pull.service playthepaper-pull.timer /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now playthepaper-pull.timer
# Logs:    journalctl -u playthepaper-pull -n 50

[Unit]
Description=Play the Paper: pull content (live) and web app (build) from GitHub
Documentation=file:///var/www/playthepaper/src/infra/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=playthepaper
Group=playthepaper
UMask=0022
Environment=HOME=/var/www/playthepaper
Environment=GIT_TERMINAL_PROMPT=0
Environment=GIT_SSH_COMMAND=ssh -o BatchMode=yes
SyslogIdentifier=playthepaper-pull
TimeoutStartSec=4min

ExecStart=/usr/bin/git -C /var/www/playthepaper/src fetch --depth 50 origin live
ExecStart=/usr/bin/git -C /var/www/playthepaper/src reset --hard origin/live
ExecStart=/usr/bin/git -C /var/www/playthepaper/app fetch --depth 50 origin build
ExecStart=/usr/bin/git -C /var/www/playthepaper/app reset --hard origin/build

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
